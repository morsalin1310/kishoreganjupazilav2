# ====================================================================
# ঢাকাস্থ কিশোরগঞ্জ উপজেলা সমিতি — Environment Variables (.env.local)
# ====================================================================

# 1. Supabase PostgreSQL Database & Storage (https://supabase.com)
# Create a free project at supabase.com and paste your project URL and keys below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. SMS Gateway Configuration (বাংলাদেশের রিয়েল মোবাইল SMS গেটওয়ে)
# সাপোর্টেড প্রোভাইডার: bulksmsbd | greenweb | mimsms | generic
SMS_PROVIDER=bulksmsbd
SMS_API_KEY=your-sms-api-key-here
SMS_SENDER_ID=KUSD
SMS_API_URL=http://bulksmsbd.net/api/smsapi

# 3. সাইট ইউআরএল ও অফিসিয়াল যোগাযোগ
NEXT_PUBLIC_SITE_URL=https://kishoreganjupazila.com
NEXT_PUBLIC_CONTACT_PHONE=01353743547
NEXT_PUBLIC_CONTACT_EMAIL=kishoreganjupazilasamity@gmail.com
